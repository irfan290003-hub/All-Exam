{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://all-exam.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://all-exam.onrender.com/uploads/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "https://all-exam.onrender.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://all-exam.onrender.com/sitemap.xml"
    },
    {
      "source": "/((?!api|uploads|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}